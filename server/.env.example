# 复制为 .env 后填写；不会提交到版本库，不要放进客户端或聊天中。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
VISION_MODEL=deepseek-flash
REASONING_MODEL=deepseek-flash
# 手机连接服务时，填写至少 24 个字符的随机口令，并在客户端设置中填写相同值。
# 未配置时仅允许本机访问。部署到公网必须使用 HTTPS。
SERVICE_TOKEN=
DATA_DIR=data
# 可选：旧 DOC / DOCX 原版布局转换所需的 LibreOffice 程序路径。
SOFFICE_PATH=
MODEL_CONCURRENCY=3
